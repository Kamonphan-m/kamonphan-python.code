def deposit(money):
    print(f"Initial balance: {money} Baht")
    user_in = input("Enter deposit amount: ")
    print()

    try:
        amt = float(user_in)
        if amt <= 0:
            raise ValueError("Deposit amount must be greater than 0")
    except ValueError as e:
        if "could not convert" in str(e) or "invalid" in str(e):
            print("Error: Please enter numbers only")
        else:
            print("Error:", e)
    else:
        total = money + amt
        print("Deposit successful")
        print(f"New balance: {total:.2f} Baht")
    finally:
        print("End of deposit transaction")


# Test the function
deposit(1000)